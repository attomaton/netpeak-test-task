LLM_PROVIDER=gemini
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=60
MAX_CONCURRENCY=1
RATE_LIMIT_REQUESTS_PER_MINUTE=15
RATE_LIMIT_WINDOW_SECONDS=60

# Локальний cache успішних класифікацій
CACHE_ENABLED=true
CACHE_FILE=.cache/classifications.json

# Checkpoint/resume успішних елементів batch
CHECKPOINT_ENABLED=true
CHECKPOINT_FILE=.cache/checkpoint.json

# Черга ручної перевірки
HUMAN_REVIEW_ENABLED=true
REVIEW_FILE=review_queue.json

# Локальні operational metrics
MONITORING_ENABLED=true
MONITORING_FILE=metrics.json

# Необов'язковий fallback. За замовчуванням вимкнений.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=heuristic
GEMINI_FALLBACK_MODEL=

# Необов'язковий Google Sheets export
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_WORKSHEET_NAME=classification_results

# Необов'язковий Telegram digest
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_TIMEOUT_SECONDS=15
